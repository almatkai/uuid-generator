{
  "schemaVersion": 2,
  "id": "com.tezbar.native.uuid-generator",
  "slug": "uuid-generator",
  "name": "UUID Generator",
  "version": "0.1.0",
  "description": "A quick way to generate UUIDs without opening the browser · Original Raycast extension by jmaeso; contributors GastroGeek, pernielsentikaer, LunaticMuch, hmarr, harsh_khandelwal, lukas-runge, ridemountainpig. Tezbar own V1 by almatkai.",
  "icon": "/extensions/icons/uuid-generator.png",
  "runtime": "rust",
  "replaces": [
    "raycast.uuid-generator"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "preferences": [
    {
      "name": "upperCaseLetters",
      "type": "checkbox",
      "required": false,
      "default": false,
      "title": "Options",
      "label": "Uppercase Letters",
      "description": "Should letters be uppercased?"
    },
    {
      "name": "defaultAction",
      "description": "Set the default action",
      "type": "dropdown",
      "required": false,
      "title": "Default Action",
      "default": "copy",
      "data": [
        {
          "title": "Copy",
          "value": "copy"
        },
        {
          "title": "Paste",
          "value": "paste"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "generate",
      "title": "Generate UUIDs",
      "description": "Copy generated UUIDs to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "numberOfUUIDsToGenerate",
          "type": "text",
          "placeholder": "1",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "generateV5",
      "title": "Generate V5 UUIDs",
      "description": "Copy generated UUIDs V5 to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "name",
          "type": "text",
          "placeholder": "UUID Name",
          "required": true
        },
        {
          "name": "numberOfUUIDsToGenerate",
          "type": "text",
          "placeholder": "1",
          "required": false
        }
      ],
      "preferences": [
        {
          "name": "uuidNamespace",
          "type": "textfield",
          "required": false,
          "default": "",
          "title": "UUID v5 Namespace",
          "label": "Namespace",
          "description": "The namespace for UUID v5"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "generateV7",
      "title": "Generate V7 UUIDs",
      "description": "Copy generated UUIDs V7 to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "numberOfUUIDsToGenerate",
          "type": "text",
          "placeholder": "1",
          "required": false
        }
      ],
      "preferences": [
        {
          "name": "base32Encoding",
          "type": "checkbox",
          "required": false,
          "default": false,
          "title": "Options",
          "label": "Base32 Encoding",
          "description": "Should letters be Base32 encoded?"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "generateUlid",
      "title": "Generate ULIDs",
      "description": "Copy generated ULIDs to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "numberOfULIDsToGenerate",
          "type": "text",
          "placeholder": "1",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "generateTypeID",
      "title": "Generate TypeIDs",
      "description": "Copy generated TypeIDs to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "prefix",
          "placeholder": "Prefix",
          "type": "text",
          "required": true
        },
        {
          "name": "numberOfUUIDsToGenerate",
          "type": "text",
          "placeholder": "1",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "parseTypeID",
      "title": "Parse TypeIDs",
      "description": "Parse TypeID and copy resulting UUID to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "typeID",
          "type": "text",
          "placeholder": "prefix_1234567890",
          "required": true
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "formatUuid",
      "title": "Format UUID",
      "description": "Format UUID without dashes into standard UUID format and copy to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "uuid",
          "type": "text",
          "placeholder": "550e8400e29b41d4a716446655440000",
          "required": true
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "packTypeID",
      "title": "Pack TypeID",
      "description": "Convert a UUID to a packed Type ID with a suffix",
      "mode": "no-view",
      "arguments": [
        {
          "name": "suffix",
          "type": "text",
          "placeholder": "Suffix",
          "required": true
        },
        {
          "name": "uuid",
          "type": "text",
          "placeholder": "UUID",
          "required": true
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    },
    {
      "name": "viewHistory",
      "title": "View History",
      "description": "View the UUID history",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust"
    }
  ],
  "verification": [
    {
      "platform": "macOS",
      "state": "not-run",
      "note": "Host registration/rebuild and real OS UI/clipboard QA have not run."
    },
    {
      "platform": "Windows",
      "state": "not-run",
      "note": "Host registration/rebuild and real OS UI/clipboard QA have not run."
    }
  ]
}
